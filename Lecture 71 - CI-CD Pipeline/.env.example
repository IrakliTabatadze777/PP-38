# Chat model the agent uses (e.g. gemini-3.6-flash)
LLM_MODEL=gemini-3.6-flash
# Model that turns knowledge-base text into vectors for search
EMBEDDING_MODEL=google_genai:gemini-embedding-2
# Google AI Studio API key for the chat and embedding models
GEMINI_API_KEY=your-key-here
# Minimum similarity score (0-1) for a knowledge-base passage to be used
RETRIEVAL_MIN_SCORE=0.69

# Main app database URL
DATABASE_URL=postgresql+psycopg://support:123123@localhost:5432/support
# Database URL for LangGraph checkpoints
CHECKPOINT_DB_URL=postgresql://support:123123@localhost:5432/support

# Secret for signing JWT tokens (32+ random characters)
JWT_SECRET=
# Access token lifetime in minutes
JWT_ACCESS_EXPIRE_MINUTES=15
# Refresh token lifetime in days
JWT_REFRESH_EXPIRE_DAYS=7
# Maximum agent steps per message
MAX_AGENT_STEPS=8
# Send agent traces to LangSmith (true/false)
LANGSMITH_TRACING=false
# LangSmith API key
LANGSMITH_API_KEY=your-key-here
# LangSmith project name for the traces
LANGSMITH_PROJECT=customer-support-agent
